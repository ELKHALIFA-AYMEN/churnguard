{
  "name": "ChurnGuard dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [5173],
  "postCreateCommand": "pip install --no-cache-dir -r ml-service/requirements-dev.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "dbaeumer.vscode-eslint"]
    }
  }
}